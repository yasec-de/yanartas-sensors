				(loss_tangent 0.025)
			)
			(layer "F.Cu"
				(type "copper")
				(thickness 0.035)
			)
			(layer "dielectric 1"
				(type "prepreg")
				(thickness 0.2104)
				(material "7628")
				(epsilon_r 4.4)
				(loss_tangent 0.02)
				(spec_frequency 1000000000)
				(dielectric_model constant)
			)
			(layer "In1.Cu"
